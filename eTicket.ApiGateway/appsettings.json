{
  "ReverseProxy": {
    "Routes": {
      "events-route": {
        "ClusterId": "event-service-cluster",
        "Match": {
          "Path": "/event-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/event-service"
          }
        ]
      }
    },
    "Clusters": {
      "event-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5111"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
